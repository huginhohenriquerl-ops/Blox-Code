<Window x:Class="BloxCode.UI.BootstrapperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.UI"
        Style="{StaticResource Window.Claude}"
        Title="Blox Code" Width="520" Height="280" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" KeyDown="OnKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Margin="18,0,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnCancel" ToolTip="Cancel" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:BitMascot Unit="0.9" IsAnimated="False" Margin="0,0,8,2" VerticalAlignment="Center"
                              Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                <TextBlock Text="Blox Code" FontFamily="{StaticResource Font.Serif}" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Stage: Bit walks along the progress bar -->
        <Grid Grid.Row="1" Margin="36,0,36,0" VerticalAlignment="Bottom">
            <Canvas x:Name="Stage" Height="78" ClipToBounds="False" SizeChanged="OnStageSizeChanged">
                <ui:BitMascot x:Name="Mascot" Unit="3.5" Mood="Walk" Canvas.Bottom="0" Canvas.Left="0"
                                Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
            </Canvas>
        </Grid>

        <StackPanel Grid.Row="2" Margin="36,6,36,0">
            <ProgressBar x:Name="Progress" Style="{StaticResource Progress}" Minimum="0" Maximum="1" Value="0" />

            <!-- Status line: "▖ Doing the thing… (12s · esc to cancel)" -->
            <DockPanel Margin="0,16,0,0">
                <Grid DockPanel.Dock="Left" Width="20" VerticalAlignment="Center">
                    <ui:BlockSpinner x:Name="Spinner" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock x:Name="ResultGlyph" FontSize="15" FontFamily="{StaticResource Font.Symbols}" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="StatusText" FontSize="15" Text="Waking up Bit…" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="DetailText" Style="{StaticResource Text.Mono}" Margin="20,5,0,0" Text="(0s · esc to cancel)" />
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="36,0,22,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LogButton" Style="{StaticResource Button.Ghost}" Content="Open log" Margin="0,0,6,0" Visibility="Collapsed" Click="OnOpenLog" />
                <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" Content="Cancel" Click="OnCancel" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
