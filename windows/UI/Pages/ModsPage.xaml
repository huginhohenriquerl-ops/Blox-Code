<UserControl x:Class="BloxCode.UI.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,8,40,40">
            <TextBlock Text="Mods" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,20"
                       Text="Pick a file for anything you want to change, or drop one onto its row. Blox Code puts it in the right place for the next launch, and Reset brings Roblox's original back." />

            <!-- One card per group (Cursor, Sounds, Font), built from ModCatalog -->
            <StackPanel x:Name="Groups" />

            <!-- Everything else: the raw folder, for mods the list above doesn't cover -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="Refresh" Click="OnRefresh" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Open folder" Click="OnOpenFolder" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Advanced: Modifications folder" Style="{StaticResource Text.H2}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                       Text="Anything else, in Roblox's own layout (for example content\textures\…)." />
                            <TextBlock x:Name="FolderPath" Style="{StaticResource Text.Mono}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                    <ItemsControl x:Name="ModList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="■" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
