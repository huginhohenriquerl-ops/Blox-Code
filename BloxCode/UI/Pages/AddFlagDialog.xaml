<Window x:Class="BloxCode.UI.Pages.AddFlagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Claude}"
        Title="Add Fast Flag" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <StackPanel>
        <DockPanel Height="48" Margin="24,0,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" IsCancel="True" Click="OnCancel" VerticalAlignment="Top" />
            <TextBlock Text="Add Fast Flag" FontFamily="{StaticResource Font.Serif}" FontSize="20" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Margin="24,4,24,20">
            <Border Style="{StaticResource Segmented}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SingleTab" Style="{StaticResource Segment}" GroupName="AddMode" Content="Add single" IsChecked="True" Checked="OnTabChanged" />
                    <RadioButton x:Name="ImportTab" Style="{StaticResource Segment}" GroupName="AddMode" Content="Import JSON" Checked="OnTabChanged" />
                </StackPanel>
            </Border>

            <!-- ===== Add single ===== -->
            <StackPanel x:Name="SinglePanel">
                <TextBlock Text="Name" Style="{StaticResource Text.H2}" FontSize="13" Margin="0,0,0,6" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" Tag="e.g. FFlagDebugGraphicsPreferVulkan"
                         TextChanged="OnSingleChanged" />

                <!-- Quick prefixes: one click starts the name with the right type -->
                <WrapPanel x:Name="PrefixChips" Margin="0,8,0,0" />

                <TextBlock x:Name="NameHint" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

                <TextBlock Text="Value" Style="{StaticResource Text.H2}" FontSize="13" Margin="0,16,0,6" />
                <Border x:Name="BoolValueHost" Style="{StaticResource Segmented}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ValueTrue" Style="{StaticResource Segment}" GroupName="BoolValue" Content="True" IsChecked="True" Checked="OnSingleChanged" />
                        <RadioButton x:Name="ValueFalse" Style="{StaticResource Segment}" GroupName="BoolValue" Content="False" Checked="OnSingleChanged" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="ValueBox" Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" Tag="value" TextChanged="OnSingleChanged" />
                <TextBlock x:Name="ValueHint" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- ===== Import JSON ===== -->
            <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Padding="8,4" Click="OnLoadFile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Text="Open .json file…" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Paste your flags" Style="{StaticResource Text.H2}" FontSize="13" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="JsonBox" Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Height="220"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Tag="{}{ &quot;FFlagDebugGraphicsPreferVulkan&quot;: &quot;True&quot;, &quot;DFIntTaskSchedulerTargetFps&quot;: 144 }"
                         TextChanged="OnJsonChanged" />
                <TextBlock x:Name="JsonHint" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                           Text="A ClientAppSettings.json, a Bloxstrap export or just a few &quot;Name&quot;: value lines." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource Button.Ghost}" Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" Content="Add flag" IsDefault="True" Click="OnConfirm" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
