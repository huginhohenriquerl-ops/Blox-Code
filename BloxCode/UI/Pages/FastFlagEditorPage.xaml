<UserControl x:Class="BloxCode.UI.Pages.FastFlagEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.UI">
    <Grid MaxWidth="900" Margin="40,0,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="8,5" Margin="-8,0,0,4" Click="OnBack">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Fast Flags" />
                </StackPanel>
            </Button>
            <TextBlock Text="Fast Flag Editor" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Muted}" Text="Manage your own Fast Flags. Changes save as you go and apply the next time Roblox launches." />
        </StackPanel>

        <!-- Allow-list notice (Bloxstrap shows the same warning) -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" VerticalAlignment="Top" Padding="0,2,0,0" />
                <TextBlock Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.TextSecondary}">
                    <Run Text="Roblox only reads Fast Flags on its allow-list, so most custom flags have no effect." />
                    <Hyperlink Click="OnAllowlistLink" Foreground="{DynamicResource Brush.Accent}">Read the announcement</Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Margin="0,16,0,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Click="OnAddNew">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Add new" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Click="OnDeleteSelected" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock x:Name="DeleteText" Text="Delete selected" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnExport" ToolTip="Copy every flag as JSON">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Export JSON" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="Toast" Style="{StaticResource Text.Muted}" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="220" HorizontalAlignment="Right" Tag="Search flags…" TextChanged="OnSearchChanged" />
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,10,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" MinWidth="150" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SelectAll" Style="{StaticResource Check}" Click="OnSelectAll" ToolTip="Select all shown" />
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource Text.Section}" Margin="2,0,0,0" />
                        <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource Text.Section}" Margin="10,0,0,0" />
                    </Grid>
                </Border>

                <ItemsControl x:Name="FlagList" Grid.Row="1" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="14,6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" MinWidth="150" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding IsChecked}" />

                                    <TextBox Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="8,5"
                                             Text="{Binding Name}" Tag="FFlagName" />

                                    <!-- Value: a switch for booleans, a text box for everything else -->
                                    <Grid Grid.Column="2" Margin="10,0,0,0">
                                        <TextBox x:Name="ValueBox" Style="{StaticResource Input}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="8,5"
                                                 Text="{Binding Value}" Tag="value" />
                                        <StackPanel x:Name="BoolPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="2,0,0,0">
                                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding BoolValue}" />
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding KindText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>

                                    <Button Grid.Column="4" Style="{StaticResource Button.Ghost}" Content="&#xE74D;" FontFamily="{StaticResource Font.Icons}"
                                            Padding="9,6" HorizontalAlignment="Right" Click="OnDeleteRow" ToolTip="Delete" />

                                    <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Error}" Style="{StaticResource Text.Muted}"
                                               Foreground="{DynamicResource Brush.Danger}" Margin="2,4,0,0" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                    <Setter TargetName="ValueBox" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="BoolPanel" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                </DataTrigger>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40">
                    <ui:BitMascot x:Name="EmptyMascot" Unit="3" HorizontalAlignment="Center"
                                    Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                    <TextBlock x:Name="EmptyTitle" Text="No custom flags yet" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Add one by name, or paste a whole JSON config." />
                    <Button x:Name="EmptyButton" Style="{StaticResource Button.Secondary}" Content="Add new" HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnAddNew" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="4,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Show preset flags" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="ShowPresets" Style="{StaticResource Toggle}" Click="OnShowPresetsChanged"
                          ToolTip="Flags managed by the toggles on the Fast Flags page" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
