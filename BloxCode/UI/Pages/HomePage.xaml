<UserControl x:Class="BloxCode.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="700" Margin="40,0,40,0"
              MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Install / default launcher banner -->
            <Border x:Name="Banner" Style="{StaticResource Card}" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="Transparent" Visibility="Collapsed" Margin="0,8,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <CheckBox x:Name="DesktopShortcut" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,0,8,0" ToolTip="Create a desktop shortcut" />
                        <TextBlock x:Name="DesktopShortcutLabel" Text="Desktop icon" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="BannerButton" Style="{StaticResource Button.Primary}" Click="OnBannerAction" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="BannerTitle" Style="{StaticResource Text.H2}" />
                        <TextBlock x:Name="BannerText" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <!-- Greeting -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <ui:ClawdMascot x:Name="Mascot" Unit="3.4" VerticalAlignment="Center" Margin="0,0,18,4"
                                    Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                    <TextBlock x:Name="Greeting" Style="{StaticResource Text.Display}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Composer -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="18" Padding="18,14,12,12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.08" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBox x:Name="Composer" Style="{StaticResource Input.Bare}" Tag="Paste a Roblox game link or place ID…"
                                 KeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged" />
                        <DockPanel Margin="0,14,0,0">
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource Button.Send}" Content="↑"
                                    Click="OnSend" ToolTip="Launch" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock x:Name="ChannelPill" Style="{StaticResource Text.Mono}" />
                                </Border>
                                <TextBlock x:Name="ComposerHint" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Text="Enter to launch · empty opens the Roblox app" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Suggestion chips -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource Button.Chip}" Click="OnOpenRoblox">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="Open Roblox" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Chip}" Click="OnFastFlags">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="Fast Flags" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Chip}" Click="OnModsFolder">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="Mods folder" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Chip}" Click="OnReinstall">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="0,0,7,0" /><TextBlock Text="Reinstall Roblox" /></StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="StatusLine" Style="{StaticResource Text.Mono}" HorizontalAlignment="Center" Margin="0,22,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
