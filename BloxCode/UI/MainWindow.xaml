<Window x:Class="BloxCode.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BloxCode.UI"
        Style="{StaticResource Window.Claude}"
        Title="Blox Code" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar (the conversation list in Claude desktop) ===== -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,0,12,12">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="56" Margin="6,0,0,0">
                    <ui:BitMascot x:Name="BrandMascot" Unit="1.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                    <TextBlock Text="Blox Code" FontFamily="{StaticResource Font.Serif}" FontSize="20" VerticalAlignment="Center" />
                </StackPanel>

                <!-- "New chat" -> "Play Roblox" -->
                <Button DockPanel.Dock="Top" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="8,7" Click="OnPlay"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Accent}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="White" HorizontalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <TextBlock Text="Play Roblox" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                </Button>

                <!-- Footer: the account chip, here showing install state -->
                <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="10,8" Margin="0,8,0,0" BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Bg}">
                    <DockPanel>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.Selected}" Margin="0,0,10,0">
                            <TextBlock Text="B" FontFamily="{StaticResource Font.Serif}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="FooterTitle" Text="Blox Code" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="FooterSubtitle" Style="{StaticResource Text.Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource Text.Section}" />
                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav.Item}" Tag="Home" Checked="OnNavigate" IsChecked="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="Home" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="FastFlags" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C1;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="Fast Flags" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Mods" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA86;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="Mods" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Appearance" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="Appearance" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="Behaviour" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="Behaviour" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Nav.Item}" Tag="About" Checked="OnNavigate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" /><TextBlock Text="About" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>
</Window>
