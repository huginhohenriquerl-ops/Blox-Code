<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BloxCode</AssemblyName>
    <RootNamespace>BloxCode</RootNamespace>
    <Description>A Claude-themed Roblox bootstrapper</Description>
    <ApplicationIcon>Resources\BloxCode.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Version and UpdateRepository come from Directory.Build.props at the repository root. -->
  <ItemGroup>
    <ProjectReference Include="..\BloxCode.Core\BloxCode.Core.csproj" />
  </ItemGroup>

  <!-- `dotnet publish -c Release` -> one self-contained BloxCode.exe, no .NET install needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\BloxCode.ico" />
  </ItemGroup>

</Project>
