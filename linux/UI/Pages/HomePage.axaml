<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BloxCode.Linux.UI"
             x:Class="BloxCode.Linux.UI.Pages.HomePage">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Layout" MaxWidth="700" Margin="40,0,40,0" RowDefinitions="Auto,*,Auto,2*">
            <!-- Things that need doing: Sober, the install, the link handler, NVIDIA -->
            <StackPanel x:Name="Banners" Margin="0,8,0,0" />

            <StackPanel Grid.Row="2">
                <!-- Greeting -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <ui:BitMascot x:Name="Mascot" Unit="2.6" VerticalAlignment="Center" Margin="0,0,18,4"
                                  Body="{DynamicResource Brush.Mascot}" Eye="{DynamicResource Brush.MascotEye}" />
                    <TextBlock x:Name="Greeting" Classes="display" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Composer -->
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="18" Padding="18,14,12,12" BoxShadow="0 4 24 0 #14000000">
                    <StackPanel>
                        <TextBox x:Name="Composer" Classes="bare" Watermark="Paste a Roblox game link or place ID…"
                                 KeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged" />
                        <DockPanel Margin="0,14,0,0">
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Classes="primary send" Click="OnSend" ToolTip.Tip="Launch">
                                <ui:IconView Data="{StaticResource Icon.Up}" Width="16" Height="16" StrokeThickness="2" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="sober" Classes="mono" />
                                </Border>
                                <TextBlock x:Name="ComposerHint" Classes="muted" VerticalAlignment="Center" Text="Enter to launch · empty opens the Roblox app" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Quick settings: the graphics preset right here, shortcuts to the rest -->
                <Border Classes="card" Margin="0,18,0,10" Padding="16,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="segmented" VerticalAlignment="Center">
                            <StackPanel x:Name="GraphicsSegments" Orientation="Horizontal" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Graphics" Classes="h2" />
                            <TextBlock x:Name="GraphicsSummary" Classes="muted" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Columns="2">
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,5,0" CornerRadius="14" Click="OnMods">
                        <Border Classes="card" Margin="0" Padding="16,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                                    <ui:IconView Data="{StaticResource Icon.Box}" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mods" Classes="h2" />
                                    <TextBlock x:Name="ModsSummary" Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="5,0,0,0" CornerRadius="14" Click="OnFastFlags">
                        <Border Classes="card" Margin="0" Padding="16,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                                    <ui:IconView Data="{StaticResource Icon.Flag}" Width="18" Height="18" Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Fast Flags" Classes="h2" />
                                    <TextBlock x:Name="FlagsSummary" Classes="muted" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>
                </UniformGrid>

                <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="chip" Click="OnOpenRoblox">
                        <StackPanel Orientation="Horizontal" Spacing="7"><ui:IconView Data="{StaticResource Icon.Play}" Width="13" Height="13" /><TextBlock Text="Open Roblox" /></StackPanel>
                    </Button>
                    <Button Classes="chip" Click="OnSober">
                        <StackPanel Orientation="Horizontal" Spacing="7"><ui:IconView Data="{StaticResource Icon.Sober}" Width="13" Height="13" /><TextBlock Text="Sober settings" /></StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="StatusLine" Classes="mono" HorizontalAlignment="Center" Margin="0,22,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
