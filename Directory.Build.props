<Project>
  <!-- Shared by BloxCode (Windows), BloxCode.Linux and BloxCode.Core so every build reports the
       same version and update feed. -->
  <PropertyGroup>
    <Version>1.1.2</Version>
    <Product>Blox Code</Product>
    <Company>Blox Code</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- GitHub "owner/repo" whose releases carry BloxCode.exe and BloxCode-x86_64.AppImage; empty
         disables self-updates. Publish a release tagged vX.Y.Z (matching <Version>). -->
    <UpdateRepository>huginhohenriquerl-ops/blox-code</UpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
</Project>
